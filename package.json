{
  "name": "node-hotelgt-apirest",
  "version": "1.0.0",
  "main": "src/api.js",
  "scripts": {
    "start": "nodemon src/api.js",
    "test": "jest --forceExit",
    "test:unit": "jest tests/unit --coverage --forceExit",
    "test:integration": "jest tests/integration --forceExit",
    "lint": "eslint \"**/*.js\" --ignore-pattern node_modules/ --ignore-pattern coverage/"
  },
  "dependencies": {
    "body-parser": "^2.2.1",
    "cors": "2.8.5",
    "express": "^5.1.0",
    "mysql2": "^3.15.3",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.1",
    "express-rate-limit": "^8.4.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.11",
    "jest": "^29.7.0",
    "eslint": "^8.57.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "controllers/**/*.js"
    ],
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ]
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "API REST - Sistema de Reservaciones para Hotel"
}